# PostgreSQL
PG_DSN=postgresql://hermes@localhost:5432/memory

# Эмбеддинги (отдельно от LLM)
EMBED_PROVIDER=auto
EMBED_API_KEY=
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=768
EMBED_SEND_DIMENSIONS=1
EMBED_STRICT_LOCAL=1

# Локальная модель (только при EMBED_PROVIDER=local)
EMBED_LOCAL_MODEL=
EMBED_LOCAL_PROFILE=e5
EMBED_LOCAL_DEVICE=cpu

# Поиск
SEARCH_MODE=hybrid
SEARCH_RRF_K=60
EMBED_EF_SEARCH=100
